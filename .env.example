# Required. Backend API base URL. The app refuses to start when this is missing or not a URL.
VITE_API_URL=http://localhost:3000/api

# Optional display name.
VITE_APP_NAME=PetAd

# "true" or "false". Enables product analytics when "true".
VITE_ENABLE_ANALYTICS=false

# "true" or "false". Enables the Mock Service Worker in local development only.
# Production builds fail when this is "true".
VITE_MSW=false

# "testnet" or "mainnet". Defaults to testnet when omitted.
VITE_STELLAR_NETWORK=testnet

# Optional Stellar account used by settlement views.
VITE_STELLAR_PUBLIC_KEY=

# Optional realtime endpoint. When set, it must be a valid URL.
VITE_REALTIME_URL=
